{
  "name": "@dyvit/whatsapp-simulator",
  "private": true,
  "version": "0.1.0",
  "description": "Cost-aware WhatsApp development environment: phone-frame emulator + deterministic pricing engine + optimization tips.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fabianocruz/whatsapp-simulator.git"
  },
  "homepage": "https://github.com/fabianocruz/whatsapp-simulator#readme",
  "type": "module",
  "packageManager": "pnpm@9.12.3",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json",
    "lint:data": "pnpm --filter @dyvit/whatsapp-pricing-data run check",
    "dev:web": "pnpm --filter @dyvit/whatsapp-simulator-web run dev",
    "build:web": "pnpm --filter @dyvit/whatsapp-simulator-web run build",
    "cli": "pnpm --filter @dyvit/whatsapp-simulator-cli run dev",
    "typecheck:web": "tsc -p apps/web/tsconfig.json",
    "build:packages": "pnpm --filter \"./packages/**\" run build"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "gifenc": "^1.0.3",
    "playwright-core": "^1.63.0",
    "pngjs": "^7.0.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
