{
  "name": "@dyvit/whatsapp-pricing-data",
  "version": "0.1.0",
  "description": "Versioned WhatsApp Business Platform rate cards and rulesets as open data.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fabianocruz/whatsapp-simulator.git",
    "directory": "packages/pricing-data"
  },
  "homepage": "https://github.com/fabianocruz/whatsapp-simulator#readme",
  "bugs": "https://github.com/fabianocruz/whatsapp-simulator/issues",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./data/*": "./data/*"
  },
  "files": [
    "dist",
    "data"
  ],
  "scripts": {
    "check": "vitest run --root ../.. packages/pricing-data",
    "build": "tsup"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "require": "./dist/index.cjs"
      },
      "./data/*": "./data/*"
    }
  }
}
