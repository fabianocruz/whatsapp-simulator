{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    // Without this, TypeScript auto-includes every @types package it finds walking up the
    // directory tree — which reaches the parent dyvit.ai project's node_modules and pulls
    // in its whole d3 type surface. React types arrive through the imports themselves, so
    // pinning this to node costs nothing and keeps the app's typecheck hermetic.
    "types": ["node"],
    "jsx": "preserve",
    "allowJs": true,
    "incremental": true,
    "plugins": [{ "name": "next" }],
    "paths": { "@/*": ["./*"] }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
